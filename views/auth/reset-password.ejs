<div class="py-16 bg-[#f4f4f5] flex items-center justify-center">
  <div class="card-awesomic p-8 w-full max-w-md">
    
    <div class="text-center mb-6">
      <div class="w-12 h-12 rounded-[16px] bg-[#09090b] text-white flex items-center justify-center text-xl font-bold border border-[#2c2e34] mx-auto mb-3">
        م
      </div>
      <h1 class="text-2xl font-extrabold text-[#09090b] tracking-tight">إعادة تعيين كلمة المرور</h1>
      <p class="text-xs text-[#71717a] mt-1">أدخل كلمة المرور الجديدة للحساب <strong><%= typeof email !== 'undefined' ? email : '' %></strong></p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-5 p-3.5 rounded-[12px] bg-red-50 border border-red-200 text-red-700 text-xs font-bold flex items-center gap-2">
        <span>⚠️</span>
        <span><%= error %></span>
      </div>
      <div class="text-center mt-4">
        <a href="/forgot-password" class="btn-primary inline-block px-5 py-2.5 text-xs font-bold rounded-[12px]">طلب رابط جديد &larr;</a>
      </div>
    <% } else { %>

      <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="mb-5 p-3.5 rounded-[12px] bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center gap-2">
          <span>✅</span>
          <span><%= successMessage %></span>
        </div>
      <% } %>

      <form action="/reset-password" method="POST" class="space-y-4" x-data="{ showPassword: false, showConfirm: false, isSubmitting: false }" @submit="isSubmitting = true">
        <input type="hidden" name="token" value="<%= token %>">
        <input type="hidden" name="email" value="<%= email %>">

        <div>
          <label class="block text-xs font-semibold text-[#18181b] mb-1.5">كلمة المرور الجديدة *</label>
          <div class="relative">
            <input :type="showPassword ? 'text' : 'password'" name="password" required minlength="6" class="input-awesomic text-xs sm:text-sm py-3 pl-10 pr-3" placeholder="••••••••">
            <button type="button" 
                    @click="showPassword = !showPassword" 
                    class="absolute left-3 top-1/2 -translate-y-1/2 text-[#71717a] hover:text-[#09090b] transition-colors p-1.5 rounded-lg focus:outline-none" 
                    title="إظهار / إخفاء كلمة المرور">
              <span x-show="!showPassword" class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </span>
              <span x-show="showPassword" class="flex items-center" x-cloak>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908A9.954 9.954 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m-4.592-4.591a3 3 0 10-4.243-4.243" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18" />
                </svg>
              </span>
            </button>
          </div>
          <p class="text-[11px] text-[#71717a] mt-1">يجب أن تتكون من 6 أحرف/أرقام على الأقل وتتضمن حروفاً وأرقاماً.</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-[#18181b] mb-1.5">تأكيد كلمة المرور الجديدة *</label>
          <div class="relative">
            <input :type="showConfirm ? 'text' : 'password'" name="confirmPassword" required minlength="6" class="input-awesomic text-xs sm:text-sm py-3 pl-10 pr-3" placeholder="••••••••">
            <button type="button" 
                    @click="showConfirm = !showConfirm" 
                    class="absolute left-3 top-1/2 -translate-y-1/2 text-[#71717a] hover:text-[#09090b] transition-colors p-1.5 rounded-lg focus:outline-none" 
                    title="إظهار / إخفاء كلمة المرور">
              <span x-show="!showConfirm" class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </span>
              <span x-show="showConfirm" class="flex items-center" x-cloak>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908A9.954 9.954 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m-4.592-4.591a3 3 0 10-4.243-4.243" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18" />
                </svg>
              </span>
            </button>
          </div>
        </div>

        <button type="submit" 
                :disabled="isSubmitting" 
                class="btn-primary w-full py-3.5 text-xs sm:text-sm font-bold rounded-[14px] mt-2 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2">
          <span x-show="!isSubmitting" class="flex items-center gap-1">
            تأكيد كلمة المرور الجديدة &larr;
          </span>
          <span x-show="isSubmitting" class="flex items-center gap-2" x-cloak>
            <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            جاري تحديث كلمة المرور...
          </span>
        </button>
      </form>

    <% } %>

    <p class="text-center text-xs text-[#71717a] mt-6">
      تذكرت كلمة المرور؟ <a href="/login" class="text-[#09090b] font-bold hover:underline">تسجيل الدخول</a>
    </p>

  </div>
</div>
