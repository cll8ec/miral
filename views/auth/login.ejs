<div class="py-16 bg-[#f4f4f5] flex items-center justify-center">
  <div class="card-awesomic p-8 w-full max-w-md">
     
     <div class="text-center mb-6">
       <div class="w-12 h-12 rounded-[16px] bg-[#09090b] text-white flex items-center justify-center text-xl font-bold border border-[#2c2e34] mx-auto mb-3">
         م
       </div>
       <h1 class="text-2xl font-extrabold text-[#09090b] tracking-tight">تسجيل الدخول</h1>
       <p class="text-xs text-[#71717a] mt-1">مرحباً بعودتك إلى متجر ميرال</p>
     </div>

     <% if (typeof error !== 'undefined' && error) { %>
       <div class="mb-5 p-3.5 rounded-[12px] bg-red-50 border border-red-200 text-red-700 text-xs font-bold flex items-center gap-2">
         <span>⚠️</span>
         <span><%= error %></span>
       </div>
     <% } %>

     <% if (typeof successMessage !== 'undefined' && successMessage) { %>
       <div class="mb-5 p-3.5 rounded-[12px] bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold flex items-center gap-2">
         <span>✅</span>
         <span><%= successMessage %></span>
       </div>
     <% } %>

     <!-- Standard Login Form -->
     <form action="/login" method="POST" class="space-y-4" 
           x-data="{ 
             showPassword: false, 
             isSubmitting: false, 
             rememberMe: false, 
             email: '' 
           }" 
           x-init="
             email = localStorage.getItem('miral_remembered_email') || '';
             rememberMe = localStorage.getItem('miral_remember_me') === 'true';
           "
           @submit="
             isSubmitting = true;
             if (rememberMe) {
               localStorage.setItem('miral_remembered_email', email);
               localStorage.setItem('miral_remember_me', 'true');
             } else {
               localStorage.removeItem('miral_remembered_email');
               localStorage.removeItem('miral_remember_me');
             }
           ">
       <div>
         <label class="block text-xs font-semibold text-[#18181b] mb-1.5">البريد الإلكتروني *</label>
         <input type="email" name="email" x-model="email" required class="input-awesomic text-xs sm:text-sm py-3" placeholder="name@domain.com">
       </div>

       <div>
         <label class="block text-xs font-semibold text-[#18181b] mb-1.5">كلمة المرور *</label>
         <div class="relative">
           <input :type="showPassword ? 'text' : 'password'" name="password" required class="input-awesomic text-xs sm:text-sm py-3 pl-10 pr-3" placeholder="••••••••">
           <button type="button" 
                   @click="showPassword = !showPassword" 
                   class="absolute left-3 top-1/2 -translate-y-1/2 text-[#71717a] hover:text-[#09090b] transition-colors p-1.5 rounded-lg focus:outline-none" 
                   title="إظهار / إخفاء كلمة المرور">
             <span x-show="!showPassword" class="flex items-center">
               <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                 <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                 <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
               </svg>
             </span>
             <span x-show="showPassword" class="flex items-center" x-cloak>
               <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                 <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908A9.954 9.954 0 0112 5c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m-4.592-4.591a3 3 0 10-4.243-4.243" />
                 <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18" />
               </svg>
             </span>
           </button>
         </div>
       </div>

       <!-- Remember Me & Options -->
       <div class="flex items-center justify-between pt-1 pb-1">
         <label class="flex items-center gap-2 cursor-pointer select-none">
           <input type="checkbox" x-model="rememberMe" name="remember" class="w-4 h-4 rounded text-[#09090b] border-gray-300 focus:ring-[#09090b]">
           <span class="text-xs font-medium text-[#18181b]">تذكرني</span>
         </label>
         <a href="/forgot-password" class="text-xs font-semibold text-[#09090b] hover:underline">نسيت كلمة المرور؟</a>
       </div>

       <button type="submit" 
               :disabled="isSubmitting" 
               class="btn-primary w-full py-3.5 text-xs sm:text-sm font-bold rounded-[14px] mt-2 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2">
         <span x-show="!isSubmitting" class="flex items-center gap-1">
           تسجيل الدخول &larr;
         </span>
         <span x-show="isSubmitting" class="flex items-center gap-2" x-cloak>
           <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
             <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
             <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
           </svg>
           جاري تسجيل الدخول...
         </span>
       </button>
     </form>

     <!-- Social Login Options (Passport.js Google & Apple) -->
     <div class="my-6 flex items-center gap-3">
       <div class="h-px bg-[#e4e4e7] flex-1"></div>
       <span class="text-[11px] font-semibold text-[#71717a] uppercase tracking-wider">أو المتابعة باستخدام</span>
       <div class="h-px bg-[#e4e4e7] flex-1"></div>
     </div>

     <div class="grid grid-cols-2 gap-3">
       <!-- Google Login Button -->
       <a href="/auth/google" 
          class="flex items-center justify-center gap-2 py-3 px-3 border border-[#e4e4e7] bg-white hover:bg-[#fafafa] active:scale-[0.98] transition-all rounded-[12px] text-xs font-bold text-[#18181b] shadow-sm">
         <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
           <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3h3.88c2.27-2.09 3.665-5.17 3.665-9.12z"/>
           <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.11-6.72-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z"/>
           <path fill="#FBBC05" d="M5.28 14.29c-.25-.72-.38-1.49-.38-2.29s.13-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.99-3.09z"/>
           <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.99 3.09c.95-2.85 3.6-4.96 6.72-4.96z"/>
         </svg>
         <span>Google</span>
       </a>

       <!-- Apple Login Button -->
       <a href="/auth/apple" 
          class="flex items-center justify-center gap-2 py-3 px-3 border border-[#09090b] bg-[#09090b] hover:bg-[#18181b] active:scale-[0.98] transition-all rounded-[12px] text-xs font-bold text-white shadow-sm">
         <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 170 170">
           <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.34.13-9.16-1.9-14.48-6.1-3.21-2.63-7.06-7.23-11.56-13.8-6.42-9.35-11.53-19.86-15.33-31.53-3.8-11.67-5.7-22.99-5.7-33.97 0-15.15 3.73-27.42 11.19-36.8 7.46-9.38 16.89-14.15 28.29-14.31 4.58 0 9.77 1.15 15.57 3.46 5.8 2.31 9.87 3.46 12.21 3.46 2.01 0 6.22-1.22 12.63-3.66 6.41-2.44 11.83-3.56 16.27-3.36 12.18.9 22.1 5.38 29.76 13.43-10.86 6.53-16.18 15.59-15.96 27.18.22 9.04 3.75 16.59 10.59 22.65 6.84 6.06 14.88 9.48 24.12 10.26-2.5 7.31-5.82 14.48-9.96 21.52zM119.22 31.81c0-6.75 2.47-13.37 7.41-19.86 4.94-6.49 11.23-10.87 18.87-13.14.65 2.12.98 4.19.98 6.21 0 6.86-2.52 13.56-7.56 20.1-5.04 6.54-11.23 10.82-18.57 12.84-.22-1.96-.33-3.67-.33-5.15z"/>
         </svg>
         <span>Apple</span>
       </a>
     </div>

     <div class="mt-6 pt-6 border-t border-[#ececee] text-center space-y-2">
       <p class="text-xs text-[#71717a]">
         ليس لديك حساب؟ <a href="/register" class="text-[#09090b] font-bold hover:underline">أنشئ حساباً جديداً</a>
       </p>
     </div>

  </div>
</div>
