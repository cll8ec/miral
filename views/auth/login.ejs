<div class="py-16 bg-[#f4f4f5] flex items-center justify-center">
  <div class="card-awesomic p-8 w-full max-w-md">
    
    <div class="text-center mb-8">
      <div class="w-12 h-12 rounded-[16px] bg-[#09090b] text-white flex items-center justify-center text-xl font-bold border border-[#2c2e34] mx-auto mb-3">
        م
      </div>
      <h1 class="text-2xl font-extrabold text-[#09090b] tracking-tight">تسجيل الدخول</h1>
      <p class="text-xs text-[#71717a] mt-1">مرحباً بعودتك إلى متجر ميرال</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-5 p-3 rounded-[12px] bg-red-50 border border-red-200 text-red-700 text-xs font-bold flex items-center gap-2">
        <span>⚠️</span>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/login" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-medium text-[#18181b] mb-1.5">البريد الإلكتروني أو رقم الجوال</label>
        <input type="text" name="email" required class="input-awesomic text-xs sm:text-sm py-2.5" placeholder="example@domain.com">
      </div>

      <div>
        <label class="block text-xs font-medium text-[#18181b] mb-1.5">كلمة المرور</label>
        <input type="password" name="password" required class="input-awesomic text-xs sm:text-sm py-2.5" placeholder="••••••••">
      </div>

      <button type="submit" class="btn-primary w-full py-3.5 text-xs sm:text-sm font-medium rounded-[14px] mt-2">
        تسجيل الدخول &larr;
      </button>
    </form>

    <div class="mt-6 pt-6 border-t border-[#ececee] text-center space-y-2">
      <p class="text-xs text-[#71717a]">
        ليس لديك حساب؟ <a href="/register" class="text-[#09090b] font-bold hover:underline">أنشئ حساباً جديداً</a>
      </p>
    </div>

  </div>
</div>
